{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

section() { printf '\n==> %s\n' "$1"; }
info()    { printf '[info] %s\n' "$1"; }
ok()      { printf '[ok] %s\n' "$1"; }
warn()    { printf '[warn] %s\n' "$1" >&2; }

section "Setting up GitHub CLI apt repository"

if [[ ! -r /etc/apt/keyrings/githubcli-archive-keyring.gpg || ! -r /etc/apt/sources.list.d/github-cli.list ]]; then
  if sudo -n true 2>/dev/null || { [[ -t 0 ]] && sudo -v; }; then
    sudo mkdir -p -m 755 /etc/apt/keyrings /etc/apt/sources.list.d

    tmp_key=$(mktemp)
    info "Downloading GitHub CLI apt keyring"
    wget -nv -O "$tmp_key" https://cli.github.com/packages/githubcli-archive-keyring.gpg
    cat "$tmp_key" | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg >/dev/null
    rm -f "$tmp_key"

    sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
    info "Writing GitHub CLI apt source"
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      | sudo tee /etc/apt/sources.list.d/github-cli.list >/dev/null
    ok "GitHub CLI apt repository configured"
  else
    warn "sudo is unavailable, skipping GitHub CLI apt repository setup"
    info "Run manually: https://github.com/cli/cli/blob/trunk/docs/install_linux.md#debian"
  fi
else
  ok "GitHub CLI apt repository already configured"
fi
{{ end -}}
