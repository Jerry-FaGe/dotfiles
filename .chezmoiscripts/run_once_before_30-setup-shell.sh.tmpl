{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

section() { printf '\n==> %s\n' "$1"; }
info()    { printf '[info] %s\n' "$1"; }
ok()      { printf '[ok] %s\n' "$1"; }
warn()    { printf '[warn] %s\n' "$1" >&2; }

section "Setting up default shell"

# 确保 zsh 已安装
if ! command -v zsh >/dev/null 2>&1; then
  warn "zsh not found, skipping shell setup"
  exit 0
fi

# 设置 zsh 为默认 shell（如果还不是的话）
ZSH_PATH=$(which zsh)
CURRENT_SHELL=$(getent passwd "$USER" | cut -d: -f7)

if [[ "$CURRENT_SHELL" != "$ZSH_PATH" ]]; then
  info "Setting default shell to zsh: $ZSH_PATH"
  if ! sudo -n true 2>/dev/null && ! { [[ -t 0 ]] && sudo -v; }; then
    warn "sudo is unavailable, skipping shell setup"
    info "Run manually: sudo chsh -s $ZSH_PATH $USER"
    exit 0
  fi

  # 确保 zsh 在 /etc/shells 中；修改该文件才需要 sudo。
  if ! grep -qx "$ZSH_PATH" /etc/shells 2>/dev/null; then
    echo "$ZSH_PATH" | sudo tee -a /etc/shells >/dev/null
  fi

  if sudo chsh -s "$ZSH_PATH" "$USER"; then
    ok "Default shell set to zsh. Changes take effect on next login."
  else
    warn "chsh failed, skipping shell setup"
    info "Run manually: sudo chsh -s $ZSH_PATH $USER"
  fi
else
  ok "zsh is already the default shell"
fi
{{ end -}}
