{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

section() { printf '\n==> %s\n' "$1"; }
info()    { printf '[info] %s\n' "$1"; }
ok()      { printf '[ok] %s\n' "$1"; }
warn()    { printf '[warn] %s\n' "$1" >&2; }

ensure_sudo() {
  if sudo -n true 2>/dev/null; then
    return 0
  fi

  # chezmoi 常通过 curl | bash 或非 stdin TTY 执行；sudo 仍可从真实终端读密码。
  if [[ -r /dev/tty && -w /dev/tty ]]; then
    sudo -v </dev/tty
    return $?
  fi

  return 1
}

section "Installing apt packages"

# 基础包列表（从 .chezmoidata/config.toml 注入）
PACKAGES=(
{{- range .packages.common.apt.packages }}
  {{ . | quote }}
{{- end }}
)

{{- if eq .machine_type "wsl" }}
# WSL 专属包
PACKAGES+=(
{{- range .packages.wsl.apt.packages }}
  {{ . | quote }}
{{- end }}
)
{{- end }}

{{- if eq .machine_type "server" }}
# 服务器专属包
PACKAGES+=(
{{- range .packages.server.apt.packages }}
  {{ . | quote }}
{{- end }}
)
{{- end }}

# 只安装缺失的包；交互环境会主动获取一次 sudo 凭据。
MISSING=()
for pkg in "${PACKAGES[@]}"; do
  if ! dpkg -s "$pkg" &>/dev/null; then
    MISSING+=("$pkg")
  fi
done

if [[ ${#MISSING[@]} -eq 0 ]]; then
  ok "All apt packages already installed"
else
  info "Missing packages: ${MISSING[*]}"
  if ensure_sudo; then
    info "Updating apt package index"
    sudo apt-get update
    info "Installing apt packages"
    sudo apt-get install -y "${MISSING[@]}"
  else
    warn "sudo is unavailable, skipping apt install"
    info "Run manually: sudo apt-get update && sudo apt-get install -y ${MISSING[*]}"
  fi
fi

ok "apt packages done"
{{ end -}}
