{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

section() { printf '\n==> %s\n' "$1"; }
info()    { printf '[info] %s\n' "$1"; }
ok()      { printf '[ok] %s\n' "$1"; }
warn()    { printf '[warn] %s\n' "$1" >&2; }

section "Checking GitHub CLI authentication"

export PATH="$HOME/.local/bin:$PATH"

if ! command -v gh >/dev/null 2>&1; then
  warn "gh not found, skipping GitHub CLI authentication check"
  exit 0
fi

if gh auth status --hostname github.com >/dev/null 2>&1; then
  ok "GitHub CLI already authenticated"
  exit 0
fi

if [[ -n "${GH_TOKEN:-${GITHUB_TOKEN:-}}" ]]; then
  token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
  if printf '%s\n' "$token" | gh auth login --hostname github.com --with-token; then
    gh auth setup-git --hostname github.com || true
    ok "GitHub CLI authenticated from GH_TOKEN/GITHUB_TOKEN"
    exit 0
  fi
fi

warn "GitHub CLI is not authenticated"
info "Run manually: gh auth login --hostname github.com --git-protocol ssh --web"
info "Then run: gh auth setup-git --hostname github.com"
{{ end -}}
