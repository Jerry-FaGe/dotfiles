{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

echo "=== Cleaning up old tools ==="

# 清理 Sheldon 残留
if command -v sheldon >/dev/null 2>&1 || [[ -d "$HOME/.config/sheldon" ]]; then
  echo "Cleaning up Sheldon..."
  rm -rf "$HOME/.config/sheldon" "$HOME/.local/share/sheldon"
  if [[ -f "$HOME/.local/bin/sheldon" ]]; then
    rm -f "$HOME/.local/bin/sheldon"
  fi
  # Sheldon 没有系统级安装，只删用户目录
  echo "Sheldon removed."
fi

# 如果有旧的 zinit 安装残留，也清理
# （保留 .local/share/zinit，那是正常的 zinit 数据目录）

echo "=== Cleanup done ==="
{{ end -}}
