{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

echo "=== Cleaning up old tools ==="

# 清理 Sheldon 残留
if command -v sheldon >/dev/null 2>&1 || [[ -d "$HOME/.config/sheldon" ]]; then
  echo "Cleaning up Sheldon..."
  rm -rf "$HOME/.config/sheldon" "$HOME/.local/share/sheldon"
  [[ -f "$HOME/.local/bin/sheldon" ]] && rm -f "$HOME/.local/bin/sheldon"
  echo "Sheldon removed."
fi

# 清理 nvm（已被 fnm 替代）
if [[ -d "$HOME/.nvm" ]]; then
  echo "Cleaning up nvm..."
  rm -rf "$HOME/.nvm"
  echo "nvm removed."
fi

# 清理 lsd（已被 eza 替代）
if command -v lsd >/dev/null 2>&1; then
  echo "Cleaning up lsd..."
  [[ -f "$HOME/.local/bin/lsd" ]] && rm -f "$HOME/.local/bin/lsd"
  rm -rf "$HOME/.config/lsd"
  echo "lsd removed."
fi

echo "=== Cleanup done ==="
{{ end -}}
