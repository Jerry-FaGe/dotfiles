#######################################################
# 代理管理
#######################################################

{{- if eq .machine_type "wsl" }}

# WSL：走 Windows 宿主代理

proxy-on() {
  local gw port proxy_url

  gw=$(awk '/^nameserver[[:space:]]+/ { print $2; exit }' /etc/resolv.conf 2>/dev/null)
  if [[ -z "$gw" ]]; then
    print 'Proxy On failed: unable to detect Windows gateway' >&2
    return 1
  fi

  for port in 7897 7890 7891; do
    if command -v nc >/dev/null 2>&1 && nc -z -w 1 "$gw" "$port" >/dev/null 2>&1; then
      proxy_url="http://$gw:$port"
      export http_proxy="$proxy_url" https_proxy="$proxy_url" all_proxy="$proxy_url"
      export HTTP_PROXY="$proxy_url" HTTPS_PROXY="$proxy_url" ALL_PROXY="$proxy_url"
      export NO_PROXY="localhost,127.0.0.1,::1,.local" no_proxy="$NO_PROXY"
      print "Proxy On: $proxy_url"
      return 0
    fi
  done

  proxy_url="http://$gw:7897"
  export http_proxy="$proxy_url" https_proxy="$proxy_url" all_proxy="$proxy_url"
  export HTTP_PROXY="$proxy_url" HTTPS_PROXY="$proxy_url" ALL_PROXY="$proxy_url"
  export NO_PROXY="localhost,127.0.0.1,::1,.local" no_proxy="$NO_PROXY"
  print "Proxy On: $proxy_url (port auto-detect failed, using default 7897)"
}

{{- else }}

# 正常 Linux：从加密下发的 zsh 私有配置读取代理信息

proxy-on() {
  local cfg="$HOME/.config/zsh/proxy.private.zsh" proxy_url

  if [[ ! -f "$cfg" ]]; then
    print 'Proxy On failed: ~/.config/zsh/proxy.private.zsh not found' >&2
    return 1
  fi

  source "$cfg"

  if [[ -z "${PROXY_SERVER_IP:-}" ]]; then
    print 'Proxy On failed: no PROXY_SERVER_IP in config' >&2
    return 1
  fi

  # 判断代理是否在本机运行。
  # 1. 先查网卡 IP（适用于非 NAT 环境）
  # 2. 再查公网 IP（适用于云服务器 NAT 环境）
  if ip addr show 2>/dev/null | grep -q "$PROXY_SERVER_IP"; then
    proxy_url="http://127.0.0.1:${PROXY_PORT:-7897}"
  elif command -v dig >/dev/null 2>&1 && \
       [[ "$(dig +short myip.opendns.com @resolver1.opendns.com 2>/dev/null)" == "$PROXY_SERVER_IP" ]]; then
    proxy_url="http://127.0.0.1:${PROXY_PORT:-7897}"
  else
    proxy_url="http://${PROXY_SERVER_IP}:${PROXY_PORT:-7897}"
  fi

  export http_proxy="$proxy_url" https_proxy="$proxy_url" all_proxy="$proxy_url"
  export HTTP_PROXY="$proxy_url" HTTPS_PROXY="$proxy_url" ALL_PROXY="$proxy_url"
  export NO_PROXY="localhost,127.0.0.1,::1,.local" no_proxy="$NO_PROXY"
  print "Proxy On: $proxy_url"
}

{{- end }}

proxy-off() {
  unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY no_proxy
  print 'Proxy Off'
}

proxy-status() {
  print "http_proxy=${http_proxy:-<unset>}"
  print "https_proxy=${https_proxy:-<unset>}"
  print "all_proxy=${all_proxy:-<unset>}"
  print "no_proxy=${no_proxy:-<unset>}"
}

_proxy_startup_notice() {
  if [[ -n "${http_proxy:-}${https_proxy:-}${all_proxy:-}" ]]; then
    print -P "%F{6}[proxy]%f 已启用: ${http_proxy:-${https_proxy:-${all_proxy:-<unknown>}}}"
  else
    print -P "%F{8}[proxy]%f 未启用（可用 proxy-on / proxy-off / proxy-status）"
  fi
}
