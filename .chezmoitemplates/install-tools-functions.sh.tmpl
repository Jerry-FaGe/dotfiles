FAILED=()
DOWNLOAD_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/downloads"

section()       { printf '\n==> %s\n' "$1"; }
info()          { printf '[info] %s\n' "$1"; }
warn()          { printf '[warn] %s\n' "$1" >&2; }
install_ok()    { printf '[ok] %s\n' "$1"; }
install_skip()  { printf '[skip] %s\n' "$1"; }
install_fail()  {
  printf '[fail] %s: %s\n' "$1" "$2" >&2
  FAILED+=("$1: $2")
}

install_summary() {
  local title="$1"

  printf '\n'
  if [[ ${#FAILED[@]} -gt 0 ]]; then
    printf '[fail] %s\n' "$title"
    printf 'Failures:\n'
    printf '  - %s\n' "${FAILED[@]}"
    exit 1
  fi

  printf '[ok] %s\n' "$title"
}

download_cached() {
  local name="$1" version="$2" url="$3" filename="$4"
  local cache_file="$DOWNLOAD_CACHE/$filename"
  local partial_file="$cache_file.partial"

  mkdir -p "$DOWNLOAD_CACHE"

  if [[ -s "$cache_file" ]]; then
    install_skip "$name v$version archive cached" >&2
    printf '%s\n' "$cache_file"
    return 0
  fi

  info "Downloading $name v$version" >&2
  info "URL: $url" >&2

  rm -f "$partial_file"

  # 交互终端显示 curl 原生进度条；日志/CI 中保持安静但保留错误信息。
  if [[ -t 2 ]]; then
    if ! curl -fL --retry 3 --retry-delay 2 --connect-timeout 15 --progress-bar -o "$partial_file" "$url"; then
      rm -f "$partial_file"
      return 1
    fi
  else
    if ! curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 15 -o "$partial_file" "$url"; then
      rm -f "$partial_file"
      return 1
    fi
  fi

  mv "$partial_file" "$cache_file"
  install_ok "$name v$version downloaded" >&2
  printf '%s\n' "$cache_file"
}

install_binary() {
  local source_path="$1" target_name="$2"
  local target_path="$HOME/.local/bin/$target_name"
  local tmp_target="$target_path.tmp.$$"

  # 先写临时文件，再原子替换，避免中断时留下半个二进制。
  install -m 755 "$source_path" "$tmp_target"
  mv "$tmp_target" "$target_path"
}

install_tar_member() {
  local name="$1" version="$2" url="$3" filename="$4" member="$5" target_name="$6"
  local archive tmp_dir

  archive="$(download_cached "$name" "$version" "$url" "$filename")" || return 1
  tmp_dir="$(mktemp -d)"
  tar xzf "$archive" -C "$tmp_dir" "$member" 2>/dev/null \
    && install_binary "$tmp_dir/$member" "$target_name"
  local rc=$?
  rm -rf "$tmp_dir"
  return "$rc"
}

install_zip_member() {
  local name="$1" version="$2" url="$3" filename="$4" member="$5" target_name="$6"
  local archive tmp_dir

  archive="$(download_cached "$name" "$version" "$url" "$filename")" || return 1
  tmp_dir="$(mktemp -d)"
  unzip -qo "$archive" "$member" -d "$tmp_dir" \
    && install_binary "$tmp_dir/$member" "$target_name"
  local rc=$?
  rm -rf "$tmp_dir"
  return "$rc"
}

install_file_binary() {
  local name="$1" version="$2" url="$3" filename="$4" target_name="$5"
  local archive

  archive="$(download_cached "$name" "$version" "$url" "$filename")" || return 1
  install_binary "$archive" "$target_name"
}

# 版本比较：返回 0=需要安装/升级，1=已是最新
need_install() {
  local cmd="$1" want="$2"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    return 0
  fi
  local have
  have=$("$cmd" --version 2>/dev/null | grep -oP '\d+\.\d+\.\d+' | head -1)
  if [[ "$have" == "$want" ]]; then
    install_skip "$cmd v$have (up to date)"
    return 1
  fi
  info "$cmd v${have:-unknown} -> v$want"
  return 0
}
